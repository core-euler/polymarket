APP_ENV=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Postgres credentials — also consumed by docker-compose.yml to build DATABASE_URL.
# CHANGE POSTGRES_PASSWORD on the server. compose will refuse to start if it is empty.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=polymarket

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/polymarket
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_ALLOWED_USER_IDS=123456789

POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com
POLYMARKET_DATA_BASE_URL=https://data-api.polymarket.com

COMET_API_KEY=replace-me
COMET_MODEL_DEFAULT=replace-me

# Bootstrap behavior. When SEED_RUN_LLM=true, seed.py drains LLM analysis,
# signal generation and paper trades after the initial market/news ingest.
# Off by default so that `docker compose up --build` does not burn Comet
# tokens unless you actually want a fully-populated database on first start.
SEED_RUN_LLM=false
SEED_DRAIN_MAX_ITERATIONS=20

# Used by the bot to call the API (e.g., for the Force-refresh button).
# Defaults to the docker-compose service name.
INTERNAL_API_BASE_URL=http://api:8000

